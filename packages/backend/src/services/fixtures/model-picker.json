models for this provider.'}</div>\n                   )}\n                   {sorted.map((m) => {\n                     const key = `${activeProvider}:${m.id}`;\ndiff --git a/packages/phone/src/lib/model-catalog.test.ts b/packages/phone/src/lib/model-catalog.test.ts\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..ddd0edebe841b89595e3b7c1670c98ff23021ca3\n--- /dev/null\n+++ b/packages/phone/src/lib/model-catalog.test.ts\n@@ -0,0 +1,36 @@\n+import { test } from 'node:test';\n+import assert from 'node:assert/strict';\n+import { compareModels, groupModels, matchesModelSearch } from './model-catalog';\n+\n+test('search matches labels, raw IDs and provider names without case sensitivity', () => {\n+  const model = { id: 'vendor/model-v2', name: 'Friendly Model' };\n+  for (const query of [' FRIENDLY ', 'MODEL-V2', 'OPENAI', 'codex']) {\n+    assert.equal(matchesModelSearch(model, query, 'openai-codex', 'Codex'), true);\n+  }\n+  assert.equal(matchesModelSearch(model, 'missing', 'openai'), false);\n+  assert.equal(matchesModelSearch(model, ''), true);\n+});\n+\n+test('sorts naturally by label then ID, preserving provider order and source arrays', () => {\n+  const models = [\n+    { provider: 'b', name: 'Model 10', id: 'v10' },\n+    { provider: 'a', name: 'Other', id: 'a' },\n+    { provider: 'b', name: 'model 2', id: 'v10' },\n+    { provider: 'b', name: 'Model 2', id: 'v2' },\n+  ];\n+  const original = [...models];\n+  assert.deepEqual(groupModels(models).map((group) => [group.provider, group.models.map((model) => model.id)]), [\n+    ['b', ['v2', 'v10', 'v10']], ['a', ['a']],\n+  ]);\n+  assert.deepEqual(models, original);\n+  assert.ok(compareModels({ name: '', id: 'model2' }, { name: '', id: 'model10' }) < 0);\n+});\n+\n+test('both phone picker surfaces use the exact search empty wording', async () => {\n+  const { readFileSync } = await import('node:fs');\n+  for (const component of ['ModelPill', 'ModelPalette']) {\n+    const source = readFileSync(new URL(`../components/${component}.tsx`, import.meta.url), 'utf8');\n+    assert.equal(source.match(/No matching models/g)?.length, 1, component);\n+    assert.doesNotMatch(source, /No model id contains|No models match/);\n+  }\n+});\ndiff --git a/packages/phone/src/lib/model-catalog.ts b/packages/phone/src/lib/model-catalog.ts\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..54edc7a0e545776fc4b6698a19cdd3a8ab6e41f6\n--- /dev/null\n+++ b/packages/phone/src/lib/model-catalog.ts\n@@ -0,0 +1,25 @@\n+interface Model {\n+  id: string;\n+  name: string;\n+}\n+\n+const order = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });\n+\n+export function compareModels(a: Model, b: Model): number {\n+  return order.compare(a.name || a.id, b.name || b.id) || order.compare(a.id, b.id);\n+}\n+\n+export function matchesModelSearch(model: Model, search: string, ...providers: string[]): boolean {\n+  const query = search.trim().toLocaleLowerCase();\n+  return [model.name, model.id, ...providers].some((value) => value.toLocaleLowerCase().includes(query));\n+}\n+\n+export function groupModels<T extends Model & { provider: string }>(models: readonly T[]): Array<{ provider: string; models: T[] }> {\n+  const groups = new Map<string, T[]>();\n+  for (const model of models) {\n+    const group = groups.get(model.provider) ?? [];\n+    group.push(model);\n+    groups.set(model.provider, group);\n+  }\n+  return [...groups].map(([provider, models]) => ({ provider, models: models.sort(compareModels) }));\n+}\n"
